<?xml version="1.0" encoding="utf-8"?>
<!-- Active-prayer highlight: rounded blue-slate capsule matching user's approved time reference.
     Maintain subtle inset so this active outline never touches adjacent prayer cells. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp"
    android:insetRight="2dp"
    android:insetTop="1dp"
    android:insetBottom="1dp">
    <shape android:shape="rectangle">
        <solid android:color="#FF354A67"/>
        <stroke android:width="1.5dp" android:color="#FF8EA7C3"/>
        <corners android:radius="24dp"/>
    </shape>
</inset>
