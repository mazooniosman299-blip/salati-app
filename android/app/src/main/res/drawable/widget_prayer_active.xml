<?xml version="1.0" encoding="utf-8"?>
<!-- Active-prayer highlight: square translucent black badge with soft neutral outline.
     Maintain subtle inset so this active outline never touches adjacent prayer cells. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp"
    android:insetRight="2dp"
    android:insetTop="1dp"
    android:insetBottom="1dp">
    <shape android:shape="rectangle">
        <solid android:color="#B8000000"/>
        <stroke android:width="1.5dp" android:color="#FF83878B"/>
        <corners android:radius="8dp"/>
    </shape>
</inset>
