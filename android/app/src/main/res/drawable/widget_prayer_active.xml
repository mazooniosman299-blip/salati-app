<?xml version="1.0" encoding="utf-8"?>
<!-- Time-only gray capsule sampled from the approved home-screen reference.
     Labels remain outside the capsule, and exactly one time is highlighted. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp" android:insetRight="2dp"
    android:insetTop="1dp" android:insetBottom="1dp">
    <shape android:shape="rectangle">
        <solid android:color="#B35B5C60"/>
        <stroke android:width="1dp" android:color="#9A85878B"/>
        <corners android:radius="20dp"/>
    </shape>
</inset>
