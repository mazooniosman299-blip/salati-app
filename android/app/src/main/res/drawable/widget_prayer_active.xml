<?xml version="1.0" encoding="utf-8"?>
<!-- Active-prayer highlight: high-contrast outline, no glow or translucent wash.
     Maintain subtle inset so this active outline never touches adjacent prayer cells. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp"
    android:insetRight="2dp"
    android:insetTop="1dp"
    android:insetBottom="1dp">
    <shape android:shape="rectangle">
        <solid android:color="#FF15181D"/>
        <stroke android:width="2dp" android:color="#E6FFFFFF"/>
        <corners android:radius="3dp"/>
    </shape>
</inset>
